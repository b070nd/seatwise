# build output
/target
/seat
/seat.exe

# release artefacts
/dist/

# Local, private notes and tooling. CI fails when anything under these is tracked.
/reference/
/.claude/

# Live configuration never belongs here: only config.example.toml is tracked. Local copies, backups and env
# files hold account identifiers.
/config.toml
config.local.toml
*.toml.bak*
*.bak-*
.env
.env.local
.env.*

.DS_Store
